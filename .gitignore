# Bukti pembayaran hasil unggahan pengguna. Foldernya tetap ikut (ada
# .gitignore di dalamnya) supaya aplikasi bisa langsung jalan setelah clone,
# tapi isi berkas yang diunggah tidak ikut ter-commit.
/public/uploads/*
!/public/uploads/bukti/
!/public/uploads/bukti/.gitignore

# Folder kerja sementara skrip uji E2E.
/storage/uji_*