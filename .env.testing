# Konfigurasi khusus saat menjalankan test otomatis (php artisan test).
#
# File ini sengaja ikut di-commit karena hanya berisi kredensial lokal
# bawaan XAMPP/Laragon (user root tanpa password). SESUAIKAN baris DB_* di
# bawah bila database MySQL Anda berbeda.
#
# WAJIB: nama database di sini harus BERBEDA dari database aplikasi
# (reservasi_futsal), karena tabel test dibangun ulang setiap kali test berjalan.

APP_NAME="Reservasi Lapangan Futsal"
APP_ENV=testing
APP_KEY=base64:1J1szmhTLw43ZgzwPxnD4kvblFyQzHmjFGzHF9fpVbs=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Buat dulu: CREATE DATABASE reservasi_futsal_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reservasi_futsal_test
DB_USERNAME=root
DB_PASSWORD=

BCRYPT_ROUNDS=4

BROADCAST_CONNECTION=null
CACHE_STORE=array
FILESYSTEM_DISK=local
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

TELESCOPE_ENABLED=false